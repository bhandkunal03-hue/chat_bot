# Frontend API base URL (Vite reads this at build time from frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend CORS and model capabilities (copy to backend/.env)
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_MODEL=openai/gpt-oss-20b
VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_MESSAGE=4
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARACTERS=60000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
